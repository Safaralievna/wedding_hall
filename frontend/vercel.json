{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wedding-hall-dmoq.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://wedding-hall-dmoq.onrender.com/uploads/:path*"
    },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
